# Ollama läuft standardmäßig lokal.
OLLAMA_URL=http://127.0.0.1:11434

# Optional: zeigt Session- und Wochenverbrauch der Ollama Cloud in der Sidebar.
# Einen persönlichen Schlüssel ausschließlich in die echte .env eintragen,
# niemals in einen Chat oder ins Git-Repository kopieren.
OLLAMA_CLOUD_USAGE_API_KEY=

# Maximale Größe je Datei und aller Dateien einer Nachricht.
MAX_UPLOAD_MB=250

# Verarbeitung großer Dateien und Archive.
CONTEXT_CHUNK_CHARS=6000
CONTEXT_CHUNK_OVERLAP=700
MAX_ARCHIVE_FILES=5000
MAX_ARCHIVE_EXTRACT_MB=120
MAX_SPREADSHEET_CELLS=300000
MAX_HISTORY_CHARS=60000
MAX_HISTORY_MESSAGES=24
MAX_HISTORY_ITEM_CHARS=12000

# Maximale Größe des persönlichen Profils je Nutzer.
MAX_PROFILE_KB=64

# Lokales Whisper-Modell: tiny, base, small, medium oder large-v3.
WHISPER_MODEL=small

# Wird ausschließlich beim Anlegen der allerersten Datenbank verwendet.
BOOTSTRAP_USER_NAME=Admin
BOOTSTRAP_USER_EMAIL=admin@example.com
BOOTSTRAP_USER_PASSWORD=
# Leer lassen: Dann erzeugt Mini LLM beim ersten Start ein zufälliges Passwort
# (steht im Protokoll und in erstes-passwort.txt im Datenordner).

# Dürfen sich weitere Personen selbst ein Konto anlegen? Standard: nein.
# Für Familie oder Team auf true setzen.
ALLOW_REGISTRATION=false
